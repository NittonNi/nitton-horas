# Copia este fichero a .env.local y rellena los valores del proyecto de Supabase.
# Panel de Supabase > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Solo si se usa Google Calendar (importar horas desde el calendario). Mismas
# credenciales OAuth que las de Supabase (Authentication > Sign In / Providers
# > Google), pero hacen falta aqui tambien porque el canje del token de
# Calendar lo hace el propio servidor de la app, no Supabase.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# No hace falta nada mas. La direccion publica de la aplicacion se configura en
# el panel de Supabase (Authentication > URL Configuration), no aqui: mirar
# DESPLIEGUE.md.

# PENDIENTE (ver ROADMAP.md, revision de seguridad 21-ago-2026): para poder
# revocar el SELECT de authenticated sobre google_connections.refresh_token
# hace falta un cliente de servidor con esta clave -Panel de Supabase >
# Project Settings > API > service_role secret key-. Nunca debe llegar al
# navegador ni usarse fuera de src/lib/supabase (server-only). Mientras no
# este puesta, google.ts y calendario/acciones.ts siguen leyendo el token con
# el cliente normal (rol authenticated), y el REVOKE de esa columna sigue sin
# aplicarse en la base -aplicarlo sin este cliente rompe la conexion de
# Google-.
# SUPABASE_SERVICE_ROLE_KEY=
